        <file alias="deform.svg">icons/toolbar/deform.svg</file>
        <file alias="export.svg">icons/toolbar/export.svg</file>
        <file alias="fit.svg">icons/toolbar/fit.svg</file>
        <file alias="import.svg">icons/toolbar/import.svg</file>
        <file alias="import-result.svg">icons/toolbar/import-result.svg</file>
        <file alias="iso-surface.svg">icons/toolbar/iso-surface.svg</file>
        <file alias="labels.svg">icons/toolbar/labels.svg</file>
        <file alias="new-layout.svg">icons/toolbar/new-layout.svg</file>
        <file alias="open.svg">icons/toolbar/open.svg</file>
        <file alias="pan.svg">icons/toolbar/pan.svg</file>
        <file alias="pick-element.svg">icons/toolbar/pick-element.svg</file>
        <file alias="pick-node.svg">icons/toolbar/pick-node.svg</file>
        <file alias="pick-part.svg">icons/toolbar/pick-part.svg</file>
        <file alias="print.svg">icons/toolbar/print.svg</file>
        <file alias="rotate.svg">icons/toolbar/rotate.svg</file>
